{
  "name": "station-pilot-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node server/ensure-sqlite.cjs",
    "check:sqlite": "node server/ensure-sqlite.cjs",
    "predev": "node server/ensure-sqlite.cjs",
    "prestart": "node server/ensure-sqlite.cjs",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "better-sqlite3": "9.6.0",
    "express": "4.22.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "3.10.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "5.0.6",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "tsx": "4.23.12",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
